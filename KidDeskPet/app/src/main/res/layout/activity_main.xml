<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp">

        <ImageView
            android:id="@+id/previewPet"
            android:layout_width="190dp"
            android:layout_height="230dp"
            android:scaleType="centerInside"
            android:contentDescription="桌宠预览"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="可爱大头娃娃桌宠"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#463944"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="8种状态 · 点击互动 · 自动休息 · 平滑小动作"
            android:textSize="15sp"
            android:textColor="#806D79"/>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="开启桌宠"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="关闭桌宠"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="桌宠大小"
            android:textStyle="bold"
            android:textColor="#5A4853"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/smallButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="小"/>

            <Button
                android:id="@+id/normalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="中"/>

            <Button
                android:id="@+id/largeButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="大"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="动作：待机呼吸、挥手摇摆、走路平移、开心跳跃、看书、托腮、打哈欠、睡觉呼吸。点击桌宠可切换状态，长时间不操作会自动睡觉。"
            android:textSize="13sp"
            android:textColor="#9A8993"/>
    </LinearLayout>
</ScrollView>
