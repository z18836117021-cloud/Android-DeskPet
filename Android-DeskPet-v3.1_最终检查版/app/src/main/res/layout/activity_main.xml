<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="220dp"
            android:src="@drawable/pet_avatar"
            android:scaleType="centerInside"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的真人桌宠 · v3"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#202531"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="已接入拆分素材：待机 / 看手机 / 思考 / 看书 / 睡觉 / 躺着玩手机 / 休息 / 走路"
            android:textSize="15sp"
            android:textColor="#667084"/>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="开启桌宠"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="关闭桌宠"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="桌宠大小"
            android:textStyle="bold"
            android:textColor="#2D3340"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/smallButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="小"/>

            <Button
                android:id="@+id/normalButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="中"/>

            <Button
                android:id="@+id/largeButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="大"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="使用说明：点击桌宠切换状态并随机说话；长时间不操作会自动进入睡觉状态；拖动可改变位置。"
            android:textSize="13sp"
            android:textColor="#8891A4"/>

    </LinearLayout>
</ScrollView>
